{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Actions module execution evidence v1",
  "type": "object",
  "required": ["schema_version", "run_id", "run_attempt", "toolkit_ref", "module_id", "complete"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "run_id": {"type": "integer", "minimum": 1},
    "run_attempt": {"type": "integer", "minimum": 1},
    "job_id": {"type": "integer", "minimum": 1, "description": "Optional only with a consumer supplied module-to-job mapping."},
    "toolkit_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "module_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "complete": {"type": "boolean"},
    "exit_code": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
    "wall_clock_seconds": {"type": ["number", "null"], "minimum": 0, "maximum": 31536000}
  },
  "additionalProperties": true
}
