    },
    {
      "id": 5,
      "title": "Step duration — mean by catalog job",
      "description": "Available steps grouped by ci_job, never by arbitrary step or test name. One catch-all histogram bucket means quantiles cannot be computed.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          },
          "expr": "topk(20, sum by (ci_job, quality) (toolkit_ci_step_duration_seconds_sum{workflow=\"ci\",environment=\"test\"}) / sum by (ci_job, quality) (toolkit_ci_step_duration_seconds_count{workflow=\"ci\",environment=\"test\"}))",
          "editorMode": "code",
          "range": true,
          "instant": false,
