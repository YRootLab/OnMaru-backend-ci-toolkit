      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 7,
      "title": "Outcomes — manifest snapshot, not run totals",
      "description": "Observation-count gauges by scope and result. Different label sets can retain earlier manifests until expiry. This is not a run failure rate or lifetime counter; use trace tables for specific runs.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          },
          "expr": "topk(20, sum by (scope, outcome) (toolkit_ci_outcome{workflow=\"ci\",environment=\"test\"}))",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "__auto"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No telemetry",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 8,
      "title": "Collection quality — retained snapshot",
      "description": "Evidence, artifact, job, step and module quality remain distinct. Missing, invalid, partial and unavailable are not success. Empty results mean no telemetry, not zero missing evidence.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          },
          "expr": "topk(20, sum by (scope, quality) (toolkit_ci_collection_quality{workflow=\"ci\",environment=\"test\"}))",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "__auto"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
