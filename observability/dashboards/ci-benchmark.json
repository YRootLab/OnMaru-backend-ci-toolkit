      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 9,
      "title": "Exporter failures — consumer-local",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Unavailable here: not exported by OTLP v1.** Read the consumer's persisted `ExportResult.status`, `reason`, `pending_batches`, `terminal_partial_batches` and request attempts. A healthy Collector or recent CI metrics cannot prove exporter success. Alert on consumer-local failed/partial delivery separately; preserve the original CI conclusion and manifest."
      }
    },
    {
      "id": 10,
      "title": "Export lag — consumer-local",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Unavailable here: not exported by OTLP v1.** Record source completion, collection time and successful export acknowledgement in consumer-local diagnostics. Lag = acknowledgement − source completion, not scrape age or observed job duration. Missing completion/acknowledgement means unknown/pending, never zero. A separately reviewed bounded health adapter is required before graphing or alerting on these values."
      }
    },
    {
      "id": 11,
      "title": "Successful workflow traces — up to 20 matches",
      "description": "Select a trace ID to open Tempo. Run ID links open original Actions and its manifest artifact list; match the selected manifest digest before downloading. Fixed repository and digit-only run IDs prevent arbitrary URL interpolation.",
      "type": "table",
      "datasource": {
        "type": "tempo",
        "uid": "local-tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "local-tempo"
          },
          "query": "{ resource.service.name = \"onmaru-ci\" && span.toolkit.ci.scope = \"workflow\" && span.cicd.pipeline.name = \"ci\" && span.vcs.repository.name = \"YRootLab/OnMaru-backend\" && span.cicd.pipeline.run.id =~ \"[1-9][0-9]{0,18}\" && span.cicd.pipeline.result = \"success\" } | select(span.cicd.pipeline.run.id, span.toolkit.ci.run.attempt, span.toolkit.ci.manifest.digest, span.cicd.pipeline.result)",
          "queryType": "traceql",
          "tableType": "spans",
          "limit": 20,
          "spss": 1
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No telemetry",
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceIdHidden"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "viz": false
                }
              },
              {
                "id": "displayName",
                "value": "Trace ID"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Tempo trace",
                    "url": "/explore?schemaVersion=1&panes=%7B%22trace%22%3A%7B%22datasource%22%3A%22local-tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22${__value.raw:percentencode}%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D%7D",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cicd.pipeline.run.id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Actions run",
                    "url": "https://github.com/YRootLab/OnMaru-backend/actions/runs/${__value.raw:percentencode}",
                    "targetBlank": true
                  },
                  {
                    "title": "Manifest artifacts",
                    "url": "https://github.com/YRootLab/OnMaru-backend/actions/runs/${__value.raw:percentencode}#artifacts",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 12,
      "title": "Non-success workflow traces — up to 20 matches",
      "description": "Includes failure, timeout, cancellation, skipped and unknown outcomes. ERROR status alone would miss cancellation. Untimed workflows have no synthetic workflow span; consult local evidence when traces are absent.",
      "type": "table",
      "datasource": {
        "type": "tempo",
        "uid": "local-tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "local-tempo"
          },
          "query": "{ resource.service.name = \"onmaru-ci\" && span.toolkit.ci.scope = \"workflow\" && span.cicd.pipeline.name = \"ci\" && span.vcs.repository.name = \"YRootLab/OnMaru-backend\" && span.cicd.pipeline.run.id =~ \"[1-9][0-9]{0,18}\" && span.cicd.pipeline.result != \"success\" } | select(span.cicd.pipeline.run.id, span.toolkit.ci.run.attempt, span.toolkit.ci.manifest.digest, span.cicd.pipeline.result)",
          "queryType": "traceql",
          "tableType": "spans",
          "limit": 20,
          "spss": 1
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No telemetry",
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceIdHidden"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "viz": false
                }
              },
              {
                "id": "displayName",
                "value": "Trace ID"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Tempo trace",
                    "url": "/explore?schemaVersion=1&panes=%7B%22trace%22%3A%7B%22datasource%22%3A%22local-tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22${__value.raw:percentencode}%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D%7D",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cicd.pipeline.run.id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Actions run",
                    "url": "https://github.com/YRootLab/OnMaru-backend/actions/runs/${__value.raw:percentencode}",
                    "targetBlank": true
                  },
                  {
                    "title": "Manifest artifacts",
                    "url": "https://github.com/YRootLab/OnMaru-backend/actions/runs/${__value.raw:percentencode}#artifacts",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    }
  ]
