        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 6,
      "title": "Observed work — latest manifest gauge",
      "description": "Job work and complete module work are separate gauges, not elapsed time. Partial coverage is retained. Do not sum the two scopes or integrate scrape samples into work totals.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          },
          "expr": "topk(20, max by (scope, quality) (toolkit_ci_work_seconds{workflow=\"ci\",environment=\"test\"}))",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "__auto"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
