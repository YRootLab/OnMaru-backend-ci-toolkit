{
  "id": null,
  "uid": "toolkit-ci-performance",
  "title": "Toolkit CI layer performance",
  "description": "Generated by scripts/build_ci_dashboard.py from observability/queries/ci-performance.json. Layer telemetry (onmaru_ci_*) and nested Tempo traces.",
  "tags": [
    "ci",
    "pipeline-toolkit"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "CI layer performance · snapshot, not cohort",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "Metric scope: **workflow=ci**. Histograms and gauges describe the latest retained execution per label set. Quantiles are estimates from that snapshot, not cohort p95 (insufficient samples until the cohort store exists). Never apply rate() to these gauges. Metric labels are finite categories; SHA, PR, run URL and test names live only in traces and manifests.\n\nMissing measurements are shown as **No telemetry**, never zero. Context, container and Flyway spans sit inside the tests span as an unverified waterfall; their durations are not added to test time. Critical path is unavailable (no causal graph)."
      }
    },
    {
      "id": 2,
      "title": "Required verify duration — p50 (latest snapshot)",
      "description": "Histogram estimate over the latest retained required-verdict job snapshot. A single run per label set is not a cohort median; cohort p50/p95 requires the 14-day sample rule.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (onmaru_ci_job_duration_seconds_bucket{workflow=\"ci\",lane=\"required-verdict\"}))",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "__auto"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No telemetry",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "Required verify duration — p95 (latest snapshot)",
      "description": "Same snapshot as p50. Shown for shape, not as a cohort p95 guarantee. Bucket bounds are explicit, so the estimate is limited by bucket width.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
