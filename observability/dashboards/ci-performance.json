    {
      "id": 15,
      "title": "Flyway spans inside the tests span",
      "description": "Each row is a Flyway span nested in its run's tests span. Placement is unverified (start at tests start, clipped to tests duration). Open the trace for the waterfall.",
      "type": "table",
      "datasource": {
        "type": "tempo",
        "uid": "local-tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "local-tempo"
          },
          "query": "{ resource.service.name = \"onmaru-ci\" && span.toolkit.ci.nested_in = \"tests\" && name = \"flyway\" && span.cicd.pipeline.name = \"ci\" && span.vcs.repository.name = \"YRootLab/OnMaru-backend\" && span.cicd.pipeline.run.id =~ \"[1-9][0-9]{0,18}\" } | select(span.cicd.pipeline.run.id, span.toolkit.ci.run.attempt, span.toolkit.ci.manifest.digest)",
          "queryType": "traceql",
          "tableType": "spans",
          "limit": 20,
          "spss": 1
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 66,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No telemetry",
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceIdHidden"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "viz": false
                }
              },
              {
                "id": "displayName",
                "value": "Trace ID"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Tempo trace",
                    "url": "/explore?schemaVersion=1&panes=%7B%22trace%22%3A%7B%22datasource%22%3A%22local-tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22${__value.raw:percentencode}%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D%7D",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cicd.pipeline.run.id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Actions run",
                    "url": "https://github.com/YRootLab/OnMaru-backend/actions/runs/${__value.raw:percentencode}",
                    "targetBlank": true
                  },
                  {
                    "title": "Manifest artifacts",
                    "url": "https://github.com/YRootLab/OnMaru-backend/actions/runs/${__value.raw:percentencode}#artifacts",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
