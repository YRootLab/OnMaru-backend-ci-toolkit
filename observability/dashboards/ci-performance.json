    {
      "id": 4,
      "title": "Build cache layer hit ratio — snapshot by lane",
      "description": "Layers in state warm divided by layers in warm or cold. Partial, invalidated and disabled layers are excluded from the denominator. Empty means no telemetry, not a zero hit ratio.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          },
          "expr": "sum by (lane) (onmaru_ci_build_cache_operations_total{workflow=\"ci\",cache_result=\"hit\"}) / sum by (lane) (onmaru_ci_build_cache_operations_total{workflow=\"ci\",cache_result=~\"hit|miss\"})",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "__auto"
