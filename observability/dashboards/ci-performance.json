      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (onmaru_ci_job_duration_seconds_bucket{workflow=\"ci\",lane=\"required-verdict\"}))",
